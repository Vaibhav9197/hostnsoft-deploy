# Port this service listens on. Optional — defaults to 4000 if unset.
# server-setup.sh sets this per environment (prod: 4000, test/demo:
# offset +1000/+2000) so multiple environments can share one host.
PORT=4000

# Base URL of the hostnsoft-api instance this service validates deploy
# tokens against (see validate-deploy-token.js). Required — server.js
# fails fast at startup if this isn't set.
#
# hostnsoft-api runs on the same box, reachable only over 127.0.0.1 today:
HOSTNSOFT_API_URL=http://127.0.0.1:4100

# Domain suffix deployed apps live under — each app becomes reachable at
# <appName>.<APPS_DOMAIN_SUFFIX> (see nomad-job-spec.js's defaultDomainFor).
# Required — this module fails fast at require-time if it isn't set.
# server-setup.sh computes and exports this per environment; set manually
# here only if running outside that script.
APPS_DOMAIN_SUFFIX=embarko.app

# Authenticates hostnsoft-api's own calls INTO this service (see
# internal-auth.js and docs/Customdomain-req.md) — the reverse direction
# of every other internal call, which all go this service -> hostnsoft-api
# on a per-company deploy token instead. Must match hostnsoft-api's
# INTERNAL_API_SECRET exactly. Required — server.js fails fast at startup
# if this isn't set.
INTERNAL_API_SECRET=change-me-shared-with-hostnsoft-api

# Browser origins allowed to call this service cross-origin (see the
# cors() block in server.js) — comma-separated, no trailing slash.
# Optional; defaults to http://localhost:3000.
#
# This only matters for the dashboard's upload button, which POSTs a
# tarball to /apps straight from the page with a proxy_auth_token. Agents,
# CI and the CLI send no Origin header at all and are unaffected by this
# value. Should match the dashboard origin hostnsoft-api has in its own
# FRONTEND_ORIGIN.
FRONTEND_ORIGIN=https://embarko.ai

# The address Docker actually publishes app container ports to on this
# box — used by the orphan-proxy sidecar to reach the app task it fronts
# (see nomad-job-spec.js). Confirmed in practice: NOT 0.0.0.0/127.0.0.1 —
# this platform's Nomad setup binds published ports to the box's own
# advertised/public IP specifically. Required — nomad-job-spec.js fails
# fast at require-time if it isn't set. server-setup.sh computes and
# exports this per environment (the same IP it detects for everything
# else); set manually here only if running outside that script.
ORIGIN_IP=203.0.113.10

# Per-app traffic/error/latency and CPU/memory analytics (see analytics/
# and docs/CLAUDE.md). Both optional — if either is unset, analytics is
# silently disabled (a warning is logged) rather than failing startup;
# analytics is additive, never load-bearing for the deploy pipeline.
#
# Path to Traefik's own JSON access log (server-setup.sh enables
# --accesslog with format=json and bind-mounts this same path into the
# Traefik container). There is only ONE Traefik instance regardless of
# environment, so this value is identical across prod/test/demo.
#
# MUST stay uncommented. hydrate_env_file (env-hydrate-lib.sh) only
# substitutes exported values into lines matching KEY=, so a commented
# entry is copied through verbatim and the key never reaches the real
# .env at all. That is not theoretical: this line and ANALYTICS_DB_PATH
# below were commented out, and every hydration silently produced a
# .env with analytics disabled — traffic and resource collection just
# quietly stopped. Fixed 2026-09-17.
TRAEFIK_ACCESS_LOG_PATH=/opt/traefik/logs/access.log

# While this file exists, new deploys are refused with 503 builds_paused.
# The platform monitor creates it when the server is short of memory and
# removes it once memory recovers (Server-setup server-setup.md#platform-monitor).
BUILDS_PAUSED_FILE=/run/embarko/builds-paused-prod

# Scale-to-zero routing. TRAEFIK_DYNAMIC_DIR is the directory Traefik
# watches; this service writes scale-to-zero.yml into it (server-setup.sh
# owns platform.yml in the same directory). ACTIVATOR_SERVICE_NAME must
# match the service server-setup.sh defines there — it carries the APP_ENV
# prefix on test/demo, so a wrong value here produces routers pointing at a
# service that does not exist, and every stopped app 404s.
# 'allowlist' — only apps named in scale-to-zero-apps.js or that opted in
# may sleep. 'universal' — every running app may, minus platform jobs, the
# hardcoded exclusions, anything that opted out, and any app that has
# served an HTTP 101 (a WebSocket app: Traefik logs such a request only
# when the connection CLOSES, so a room full of connected users looks
# exactly like an idle app).
SCALE_TO_ZERO_MODE=allowlist
TRAEFIK_DYNAMIC_DIR=/opt/traefik/dynamic
ACTIVATOR_SERVICE_NAME=scale-to-zero-activator
#
# Where this service's own local analytics database lives — MUST be
# outside this repo's checkout (server-setup.sh's clean_pull does `git
# reset --hard && git clean -fd` on every re-run, which would destroy a
# file living inside it). server-setup.sh computes and exports a
# per-environment path under /opt/hostnsoft-analytics/ and substitutes
# it here. The value below is only the fallback for a hand-run outside
# that script — and note it names the PROD path, so do not rely on it
# for test/demo. See the uncommented-on-purpose note above.
ANALYTICS_DB_PATH=/opt/hostnsoft-analytics/prod/analytics.db
#
# Host directory holding every app's persistent DATA_DIR, one
# subdirectory per app, bind-mounted into each container at /data (see
# nomad-job-spec.js's appDataPathFor). Required — deploy-service refuses
# to start without it, since a missing value would silently put app
# databases back inside the disposable allocation.
#
# Must live OUTSIDE any git-managed checkout, same reason as
# ANALYTICS_DB_PATH above: server-setup.sh's clean_pull runs `git reset
# --hard && git clean -fd`, which would erase every app's database.
# server-setup.sh computes and exports a per-environment path under
# /opt/embarko-appdata/; set manually here only if running outside it.
APP_DATA_ROOT=/opt/embarko-appdata/prod
#
# How often the access-log tailer polls for new lines, and the resource
# poller samples container stats, in milliseconds. Both optional —
# sensible defaults below.
# ACCESS_LOG_POLL_INTERVAL_MS=5000
# RESOURCE_POLL_INTERVAL_MS=60000
#
# Where the resource poller reads live CPU/memory from — Docker's own
# stats API (see analytics/resource-poller.js; Nomad's own client-side
# stats endpoint was found NOT to populate per-task stats on this host's
# cgroup setup, 2026-09-12), over Docker's Unix socket. Optional, defaults
# to Docker's standard path — only set this if Docker's socket lives
# somewhere non-standard on this host.
# DOCKER_SOCKET_PATH=/var/run/docker.sock
#
# How long raw analytics rows are kept before being pruned, in days —
# see analytics/retention.js. Optional, defaults to 100.
# ANALYTICS_RETENTION_DAYS=100

# How many of an app's most recent local build images to keep before
# older ones are pruned (see image-retention.js) — bounds disk usage and
# defines how far back one-click rollback can reach. Optional, defaults
# to 5.
# IMAGE_RETAIN_COUNT=5

# How long the rename endpoint waits for the new hostname's certificate
# before giving up and putting the app back (see rename-app.js), and how
# often it re-checks. Both optional — 240000ms and 5000ms.
#
# The wait exists because the platform zone has no wildcard certificate:
# every app holds its own single-name cert, so a renamed app is not
# reachable until Let's Encrypt has issued one for the new hostname.
# Answering before then would report a rename that can still roll back.
# Lower them only in a test environment.
# RENAME_CERT_WAIT_MS=240000
# RENAME_CERT_POLL_MS=5000
#
# The port Traefik serves HTTPS on, used only by that same check — it
# connects to the local edge with SNI rather than resolving the hostname
# publicly, so it needs the port directly. Optional, defaults to 443.
# Set it only if Traefik is not on the standard port.
# EDGE_HTTPS_PORT=443
# Static apps (see docs/Static-apps-req.md): a plain static site is not
# built or run as a container — its files are published under
# STATIC_SITES_ROOT and served by the shared static server that
# server-setup.sh runs next to Traefik. All four are required; the service
# refuses to start without them (same fail-fast convention as
# APP_DATA_ROOT above). MUST stay uncommented — see the hydrate_env_file
# note on TRAEFIK_ACCESS_LOG_PATH.
#
# One subdirectory per app. Must live OUTSIDE any git-managed checkout,
# same reason as APP_DATA_ROOT. server-setup.sh computes and exports a
# per-environment path; the value below is the PROD path.
STATIC_SITES_ROOT=/opt/embarko-static/prod/sites
#
# The directory Traefik's file provider watches (--providers.file.directory).
# deploy-service writes one router file per static app here, beside the
# platform's own <env>platform.yml. Shared by every environment, since
# there is only one Traefik per host.
TRAEFIK_DYNAMIC_DIR=/opt/traefik/dynamic
#
# Loopback ports of the shared static server (Caddy) and of the shared
# orphan-banner proxy in front of it, as the static-server Nomad job binds
# them. server-setup.sh offsets these per environment the same way as PORT.
STATIC_SERVER_PORT=4300
STATIC_ORPHAN_PROXY_PORT=4310

# Optional. How long POST /apps waits for a static site to publish before
# answering "check back" instead (ms). Almost every static site is done in
# about a second, so the agent gets the live result in one reply. Keep it
# well under Cloudflare's ~100s and the dashboard proxy's 120s timeouts.
# STATIC_WAIT_MS=5000

# Local image registry every built image is pushed to after a successful
# deploy (see image-registry.js; server-setup.md#image-registry). Loopback
# only. server-setup.sh computes it per environment (127.0.0.1:4400 +
# the port offset); the value below is the PROD address. Empty disables
# the push. MUST stay uncommented — see the hydrate_env_file note on
# TRAEFIK_ACCESS_LOG_PATH.
REGISTRY_ADDR=127.0.0.1:4400
#
# Upper bound on one push, in milliseconds. Optional, defaults to 600000.
# REGISTRY_PUSH_TIMEOUT_MS=600000

# Redis for this service (see redis.js; one shared client). Optional,
# defaults to the box's local Redis.
# REDIS_URL=redis://127.0.0.1:6379

# Rate limits on POST /apps (see rate-limit.js; wired in server.js).
# Counters live in Redis. Optional — defaults as shown.
#
# Per caller: counted per deploy token, per company for dashboard
# uploads, or per client IP for anonymous deploys.
# UPLOAD_LIMIT=10
# UPLOAD_LIMIT_WINDOW_MIN=1
#
# Per client IP, applied to every request whether or not it carries a
# token. Keep it looser than UPLOAD_LIMIT: many honest callers (an
# office, a CI runner pool) share one address.
# UPLOAD_IP_LIMIT=30
# UPLOAD_IP_LIMIT_WINDOW_MIN=1
#
# Largest tarball POST /apps accepts, in bytes. Optional, default 500 MB.
# UPLOAD_MAX_BYTES=524288000
