# Port this service listens on. Optional — defaults to 4000 if unset.
# server-setup.sh sets this per environment (prod: 4000, test/demo:
# offset +1000/+2000) so multiple environments can share one host.
PORT=4000

# Base URL of the hostnsoft-api instance this service validates deploy
# tokens against (see validate-deploy-token.js). Required — server.js
# fails fast at startup if this isn't set.
#
# hostnsoft-api runs on the same box, reachable only over 127.0.0.1 today:
HOSTNSOFT_API_URL=http://127.0.0.1:4100

# Domain suffix deployed apps live under — each app becomes reachable at
# <appName>.<APPS_DOMAIN_SUFFIX> (see nomad-job-spec.js's defaultDomainFor).
# Required — this module fails fast at require-time if it isn't set.
# server-setup.sh computes and exports this per environment; set manually
# here only if running outside that script.
APPS_DOMAIN_SUFFIX=app.example.com

# Authenticates hostnsoft-api's own calls INTO this service (see
# internal-auth.js and docs/Customdomain-req.md) — the reverse direction
# of every other internal call, which all go this service -> hostnsoft-api
# on a per-company deploy token instead. Must match hostnsoft-api's
# INTERNAL_API_SECRET exactly. Required — server.js fails fast at startup
# if this isn't set.
INTERNAL_API_SECRET=change-me-shared-with-hostnsoft-api

# The address Docker actually publishes app container ports to on this
# box — used by the orphan-proxy sidecar to reach the app task it fronts
# (see nomad-job-spec.js). Confirmed in practice: NOT 0.0.0.0/127.0.0.1 —
# this platform's Nomad setup binds published ports to the box's own
# advertised/public IP specifically. Required — nomad-job-spec.js fails
# fast at require-time if it isn't set. server-setup.sh computes and
# exports this per environment (the same IP it detects for everything
# else); set manually here only if running outside that script.
ORIGIN_IP=203.0.113.10

# Per-app traffic/error/latency and CPU/memory analytics (see analytics/
# and docs/CLAUDE.md). Both optional — if either is unset, analytics is
# silently disabled (a warning is logged) rather than failing startup;
# analytics is additive, never load-bearing for the deploy pipeline.
#
# Path to Traefik's own JSON access log (server-setup.sh enables
# --accesslog with format=json and bind-mounts this same path into the
# Traefik container). There is only ONE Traefik instance regardless of
# environment, so this value is identical across prod/test/demo.
# TRAEFIK_ACCESS_LOG_PATH=/opt/traefik/logs/access.log
#
# Where this service's own local analytics database lives — MUST be
# outside this repo's checkout (server-setup.sh's clean_pull does `git
# reset --hard && git clean -fd` on every re-run, which would destroy a
# file living inside it). server-setup.sh computes and exports a
# per-environment path under /opt/hostnsoft-analytics/; set manually
# here only if running outside that script.
# ANALYTICS_DB_PATH=/opt/hostnsoft-analytics/prod/analytics.db
#
# How often the access-log tailer polls for new lines, and the resource
# poller samples Nomad's stats API, in milliseconds. Both optional —
# sensible defaults below.
# ACCESS_LOG_POLL_INTERVAL_MS=5000
# RESOURCE_POLL_INTERVAL_MS=60000
#
# How long raw analytics rows are kept before being pruned, in days —
# see analytics/retention.js. Optional, defaults to 100.
# ANALYTICS_RETENTION_DAYS=100

# How many of an app's most recent local build images to keep before
# older ones are pruned (see image-retention.js) — bounds disk usage and
# defines how far back one-click rollback can reach. Optional, defaults
# to 5.
# IMAGE_RETAIN_COUNT=5
