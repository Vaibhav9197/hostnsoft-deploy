# Port this service listens on. Optional — defaults to 4000 if unset.
# server-setup.sh sets this per environment (prod: 4000, test/demo:
# offset +1000/+2000) so multiple environments can share one host.
PORT=4000

# Base URL of the hostnsoft-api instance this service validates deploy
# tokens against (see validate-deploy-token.js). Required — server.js
# fails fast at startup if this isn't set.
#
# hostnsoft-api runs on the same box, reachable only over 127.0.0.1 today:
HOSTNSOFT_API_URL=http://127.0.0.1:4100

# Domain suffix deployed apps live under — each app becomes reachable at
# <appName>.<APPS_DOMAIN_SUFFIX> (see nomad-job-spec.js's defaultDomainFor).
# Required — this module fails fast at require-time if it isn't set.
# server-setup.sh computes and exports this per environment; set manually
# here only if running outside that script.
APPS_DOMAIN_SUFFIX=app.example.com

# Authenticates hostnsoft-api's own calls INTO this service (see
# internal-auth.js and docs/Customdomain-req.md) — the reverse direction
# of every other internal call, which all go this service -> hostnsoft-api
# on a per-company deploy token instead. Must match hostnsoft-api's
# INTERNAL_API_SECRET exactly. Required — server.js fails fast at startup
# if this isn't set.
INTERNAL_API_SECRET=change-me-shared-with-hostnsoft-api
